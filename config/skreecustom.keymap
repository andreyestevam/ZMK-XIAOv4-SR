//#include <behaviors/mouse_keys.dtsi>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 140

#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        mouse_scroll: sensor_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <5>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
            quick-tap-ms = <400>;
            require-prior-idle-ms = <400>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC                          &kp N1               &kp N2               &kp N3           &kp N4             &kp N5          &kp N6      &kp N7          &kp N8            &hmr LG(LS(N9)) N9  &kp N0                        &kp EQUAL
&kp TAB                          &kp Q                &kp W                &kp E            &kp R              &kp T           &kp Y       &kp U           &kp I             &kp O               &kp P                         &kp MINUS
&kp CAPSLOCK                     &hmr LEFT_CONTROL A  &hmr LEFT_COMMAND S  &hmr LEFT_ALT D  &hmr LEFT_SHIFT F  &kp G           &kp H       &hmr RSHFT J    &hmr RIGHT_ALT K  &hmr RIGHT_GUI L    &hmr RIGHT_CONTROL SEMICOLON  &kp SQT
&kp LSHFT                        &kp Z                &kp X                &hmr LG(C) C     &hmr LG(V) V       &kp B           &kp N       &kp M           &kp COMMA         &kp DOT             &kp FSLH                      &kp BSLH
&hmr LC(LG(SPACE)) LEFT_CONTROL  &mo 5                &mo 6                &mkp MB1         &mkp MB2                                       &kp LEFT_ARROW  &kp RIGHT         &kp DOWN            &kp UP_ARROW                  &mo 3
                                                                                            &tog 7             &tog 1          &kp C_MUTE
                                                                           &kp LSHFT        &kp LEFT_CONTROL   &kp LEFT_ALT    &kp TAB     &kp DEL         &kp RGUI
                                                                           &kp SPACE        &kp LEFT_COMMAND   &kp TAB         &kp RSHIFT  &kp ENTER       &kp BACKSPACE
            >;

            sensor-bindings =
                <&inc_dec_kp C_PREVIOUS C_NEXT>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>,
                <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        winLayer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
                                &trans  &trans    &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        bleLayer {
            bindings = <
&bt BT_CLR      &trans  &trans  &trans  &bt BT_PRV  &bt BT_NXT     &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans  &trans  &trans  &trans      &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans  &trans  &trans  &trans      &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans  &trans  &trans  &trans      &trans         &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR_ALL  &trans  &trans  &trans  &trans                             &trans  &trans  &trans  &trans  &trans
                                        &trans      &bootloader    &trans
                                &trans  &trans      &trans         &trans  &trans  &trans
                                &trans  &trans      &trans         &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                         &trans  &trans  &trans  &trans  &trans
                                &trans  &trans    &bootloader
                        &trans  &trans  &trans    &trans       &trans  &trans
                        &trans  &trans  &trans    &trans       &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
                                &trans  &trans    &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        numPad {
            bindings = <
&trans  &trans  &trans  &trans    &trans    &trans    &kp ESCAPE   &kp N0        &kp SLASH     &kp ASTERISK        &kp MINUS    &kp CLEAR
&trans  &trans  &trans  &trans    &trans    &trans    &kp PERCENT  &kp N7        &kp N8        &hmr LG(LS(N9)) N9  &kp KP_PLUS  &trans
&trans  &trans  &trans  &trans    &trans    &trans    &kp COMMA    &kp NUMBER_4  &kp N5        &kp NUMBER_6        &kp COMMA    &trans
&trans  &trans  &trans  &trans    &trans    &trans    &kp N0       &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3        &kp RETURN   &trans
&trans  &trans  &trans  &mkp MB1  &mkp MB2                         &kp N0        &kp PERIOD    &kp EQUAL           &kp ENTER    &trans
                                  &trans    &trans    &trans
                        &trans    &trans    &trans    &trans       &trans        &trans
                        &trans    &trans    &trans    &trans       &trans        &trans
            >;
        };

        mouseEmulation {
            bindings = <
&trans  &trans  &trans  &trans    &trans    &trans    &trans          &msc SCRL_UP    &trans           &trans    &trans          &trans
&trans  &trans  &trans  &trans    &trans    &trans    &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans    &trans          &trans
&trans  &trans  &trans  &trans    &trans    &trans    &trans          &mmv MOVE_UP    &trans           &trans    &trans          &trans
&trans  &trans  &trans  &trans    &trans    &trans    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans    &kp UP_ARROW    &trans
&trans  &trans  &trans  &mkp MB1  &mkp MB2                            &trans          &trans           &kp LEFT  &kp DOWN_ARROW  &kp RIGHT
                                  &trans    &trans    &trans
                        &trans    &trans    &trans    &trans          &trans          &trans
                        &trans    &trans    &trans    &trans          &trans          &trans
            >;
        };

        gamingLayer {
            bindings = <
&trans    &trans     &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&kp APOS  &kp TAB    &kp Q   &kp W   &kp E   &kp R     &trans  &trans  &trans  &trans  &trans  &trans
&kp T     &kp LSHFT  &kp A   &kp S   &kp D   &kp F     &trans  &trans  &trans  &trans  &trans  &trans
&kp B     &kp LCTRL  &kp Z   &kp X   &kp C   &kp G     &trans  &trans  &trans  &trans  &trans  &trans
&trans    &trans     &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
                                     &trans  &trans    &trans
                             &trans  &trans  &trans    &trans  &trans  &trans
                             &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        macrosLayer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
                                &trans  &trans    &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
