//#include <behaviors/mouse_keys.dtsi>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 140

#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        mouse_scroll: sensor_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <5>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <300>;
            flavor = "tap-preferred";
        };

        CMD_ESC_doubleTap: CMD_ESC_doubleTap {
            compatible = "zmk,behavior-tap-dance";
            label = "CMD_ESC_DOUBLETAP";
            #binding-cells = <0>;
            bindings = <&kp LEFT_COMMAND>, <&kp ESC>;
        };

        hKeyRepeat: hKeyRepeat {
            compatible = "zmk,behavior-tap-dance";
            label = "HKEYREPEAT";
            #binding-cells = <0>;
            bindings = <&kp H>, <&key_repeat>;
        };

        symbolsLayerDoubleTap: symbolsLayerDoubleTap {
            compatible = "zmk,behavior-tap-dance";
            label = "SYMBOLSLAYERDOUBLETAP";
            #binding-cells = <0>;
            bindings = <&mo 9>, <&tog 9>;
        };

        unicodeArrowsSymbol: unicodeArrowsSymbol {
            compatible = "zmk,behavior-tap-dance";
            label = "UNICODEARROWSSYMBOL";
            #binding-cells = <0>;
            bindings = <&rightArrowUnicode>, <&doubleArrowUnicode>;
        };

        programmingParenthesisBehavior: programmingParenthesisBehavior {
            compatible = "zmk,behavior-tap-dance";
            label = "PROGRAMMINGPARENTHESISBEHAVIOR";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&leftParenthesisMacro>;

            tapping-term-ms = <200>;
        };

        commentingProgrammingBehavior: commentingProgrammingBehavior {
            compatible = "zmk,behavior-tap-dance";
            label = "COMMENTINGPROGRAMMINGBEHAVIOR";
            #binding-cells = <0>;
            bindings = <&kp HASH>, <&commentingMacro>;
        };

        zNumpadDT: zNumpadDT {
            compatible = "zmk,behavior-tap-dance";
            label = "ZNUMPADDT";
            #binding-cells = <0>;
            bindings = <&kp Z>, <&tog 5>;
        };

        holdMoTapKp: holdMoTapKp {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLDMOTAPKP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <300>;
            flavor = "tap-preferred";
        };

        curlyBracketBehavior: curlyBracketBehavior {
            compatible = "zmk,behavior-tap-dance";
            label = "CURLYBRACKETBEHAVIOR";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LEFT_BRACE>, <&curlyBracketMacro>;
        };

        doubleQuoteBehavior: doubleQuoteBehavior {
            compatible = "zmk,behavior-tap-dance";
            label = "DOUBLEQUOTEBEHAVIOR";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp DOUBLE_QUOTES>, <&doubleQuoteBehavior>;
        };

        singleQuoteBehavior: singleQuoteBehavior {
            compatible = "zmk,behavior-tap-dance";
            label = "SINGLEQUOTEBEHAVIOR";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp SINGLE_QUOTE>, <&singleQuoteMacro>;
        };

        squareBracketBehavior: squareBracketBehavior {
            compatible = "zmk,behavior-tap-dance";
            label = "SQUAREBRACKETBEHAVIOR";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LEFT_BRACKET>, <&squareBracketMacro>;
        };
    };

    combos {
        compatible = "zmk,combos";

        CapsAndShift {
            bindings = <&hmr LSHFT CAPSLOCK>;
            key-positions = <61 66>;
        };

        warpdCombo {
            bindings = <&kp LA(LG(X))>;
            key-positions = <69 70>;
        };
    };

    macros {
        discord: discord {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE) &kp LS(O) &kp P &kp E &kp R &kp A &kp RET &kp LG(T) &kp H &kp T &kp T &kp P &kp S &kp COLON &kp FSLH &kp FSLH &kp D &kp I &kp S &kp C &kp O &kp R &kp D &kp DOT &kp C &kp O &kp M &kp FSLH &kp C &kp H &kp A &kp N &kp N &kp E &kp L &kp S &kp FSLH &kp AT &kp M &kp E &kp RET>;
            label = "DISCORD";
        };

        laughingEmoji: laughingEmojih {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LC(SPACE)) &kp L &kp A &kp U &kp G &kp H &kp I &kp N &kp G &kp RET>;
            label = "LAUGHINGEMOJIH";
        };

        wordSelection: wordSelection {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LA(RIGHT_ARROW)) &kp LG(C)>;
            label = "WORDSELECTION";
        };

        copyFile: copyFile {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE) &kp F &kp I &kp N &kp D &kp E &kp R &kp RET &kp DOWN &kp LG(C) &kp LG(SPACE) &kp V &kp S &kp C &kp O &kp D &kp E &kp RET &kp LG(V) &kp ENTER>;
            label = "COPYFILE";
        };

        commaSpace: commaSpace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COMMA &kp SPACE>;
            label = "COMMASPACE";
        };

        leftParenthesisMacro: programmingParenthesis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT_ARROW>;
            label = "PROGRAMMINGPARENTHESIS";
        };

        rightArrowUnicode: rightArrowDoubleTap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LC(SPACE)) &kp R &kp I &kp G &kp H &kp T &kp SPACE &kp A &kp R &kp R &kp O &kp W &kp RET>;
            label = "RIGHTARROWDOUBLETAP";
        };

        doubleArrowUnicode: doubleArrowUnicode {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LC(SPACE)) &kp R &kp I &kp G &kp H &kp T &kp W &kp A &kp R &kp D &kp S &kp SPACE &kp D &kp O &kp U &kp B &kp L &kp E &kp SPACE &kp A &kp R &kp R &kp O &kp W &kp RET>;
            label = "DOUBLEARROWUNICODE";
        };

        commentingMacro: commentingMacro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk LGUI &kp K &sk LEFT_COMMAND &kp C>;
            label = "COMMENTINGMACRO";
        };

        curlyBracketMacro: curlyBracketMacro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE &kp RIGHT_BRACE &kp LEFT_ARROW>;
            label = "CURLYBRACKETMACRO";
        };

        doubleQuoteMacro: doubleQuoteMacro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOUBLE_QUOTES &kp DOUBLE_QUOTES &kp LEFT_ARROW>;
            label = "DOUBLEQUOTEMACRO";
        };

        singleQuoteMacro: singleQuoteMacro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SINGLE_QUOTE &kp SINGLE_QUOTE &kp LEFT_ARROW>;
            label = "SINGLEQUOTEMACRO";
        };

        squareBracketMacro: squareBracketMacro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT_ARROW>;
            label = "SQUAREBRACKETMACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC       &kp N1               &kp N2               &kp N3            &kp N4              &kp N5          &kp N6      &kp N7         &kp N8            &hmr LG(LS(N9)) N9  &kp N0                        &kp EQUAL
&kp TAB       &kp Q                &kp W                &kp E             &hmr LG(R) R        &hmr LG(T) T    &kp Y       &kp U          &kp I             &kp O               &kp P                         &kp MINUS
&kp CAPSLOCK  &hmr LEFT_CONTROL A  &hmr LEFT_COMMAND S  &hmr LEFT_ALT D   &hmr LEFT_SHIFT F   &kp G           &kp H       &hmr RSHFT J   &hmr RIGHT_ALT K  &hmr RIGHT_GUI L    &hmr RIGHT_CONTROL SEMICOLON  &kp SQT
&kp LSHFT     &kp Z                &kp X                &hmr LG(C) C      &hmr LG(V) V        &kp B           &kp N       &kp M          &kp COMMA         &kp DOT             &hmr LG(LA(FSLH)) FSLH        &kp BSLH
&kp LCTRL     &mo 5                &mo 6                &mkp MB1          &mkp MB2                                        &tog 11        &kp MINUS         &kp SQT             &kp GRAVE                     &mo 4
                                                                          &tog 7              &tog 3          &kp C_MUTE
                                                        &mo 10            &mo 5               &sl 8           &kp LC(D)   &kp LA(LG(X))  &mo 9
                                                        &hmr LSHFT SPACE  &CMD_ESC_doubleTap  &kp TAB         &kp RSHIFT  &kp ENTER      &kp BACKSPACE
            >;

            sensor-bindings =
                <&inc_dec_kp C_PREVIOUS C_NEXT>,
                <&inc_dec_kp LC(LG(Q)) C_PLAY_PAUSE>,
                <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                         &trans  &trans  &trans  &trans  &trans
                                &trans  &trans    &bootloader
                        &trans  &trans  &trans    &trans       &trans  &trans
                        &trans  &trans  &trans    &trans       &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
                                &trans  &trans    &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        winLayer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
                                &trans  &trans    &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        bleLayer {
            bindings = <
&bt BT_CLR      &trans  &trans  &trans  &bt BT_PRV  &bt BT_NXT     &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans  &trans  &trans  &trans      &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans  &trans  &trans  &trans      &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans  &trans  &trans  &trans      &trans         &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR_ALL  &trans  &trans  &trans  &trans                             &trans  &trans  &trans  &trans  &trans
                                        &trans      &bootloader    &trans
                                &trans  &trans      &trans         &trans  &trans  &trans
                                &trans  &trans      &trans         &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        numPad {
            bindings = <
&trans  &trans  &trans  &trans    &trans    &trans    &kp ESCAPE   &kp N0        &kp SLASH     &kp ASTERISK        &kp MINUS    &kp CLEAR
&trans  &trans  &trans  &trans    &trans    &trans    &kp PERCENT  &kp N7        &kp N8        &hmr LG(LS(N9)) N9  &kp KP_PLUS  &trans
&trans  &trans  &trans  &trans    &trans    &trans    &kp COMMA    &kp NUMBER_4  &kp N5        &kp NUMBER_6        &kp COMMA    &trans
&trans  &trans  &trans  &trans    &trans    &trans    &kp N0       &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3        &kp RETURN   &trans
&trans  &trans  &trans  &mkp MB1  &mkp MB2                         &kp N0        &kp PERIOD    &kp EQUAL           &kp ENTER    &trans
                                  &trans    &trans    &trans
                        &trans    &trans    &trans    &trans       &trans        &trans
                        &trans    &trans    &trans    &trans       &trans        &trans
            >;
        };

        mouseEmulation {
            bindings = <
&trans  &trans  &trans  &trans    &trans    &trans    &trans          &msc SCRL_UP    &trans           &trans    &trans          &trans
&trans  &trans  &trans  &trans    &trans    &trans    &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans    &trans          &trans
&trans  &trans  &trans  &trans    &trans    &trans    &trans          &mmv MOVE_UP    &trans           &trans    &trans          &trans
&trans  &trans  &trans  &trans    &trans    &trans    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans    &kp UP_ARROW    &trans
&trans  &trans  &trans  &mkp MB1  &mkp MB2                            &trans          &trans           &kp LEFT  &kp DOWN_ARROW  &kp RIGHT
                                  &trans    &trans    &trans
                        &trans    &trans    &trans    &trans          &trans          &trans
                        &trans    &trans    &trans    &trans          &trans          &trans
            >;
        };

        gamingLayer {
            bindings = <
&trans    &trans     &trans  &trans  &trans     &trans    &trans  &trans  &trans  &trans  &trans  &trans
&kp APOS  &kp TAB    &kp Q   &kp W   &kp E      &kp R     &trans  &trans  &trans  &trans  &trans  &trans
&kp T     &kp LSHFT  &kp A   &kp S   &kp D      &kp F     &trans  &trans  &trans  &trans  &trans  &trans
&kp B     &kp LCTRL  &kp Z   &kp X   &kp C      &kp G     &trans  &trans  &trans  &trans  &trans  &trans
&trans    &trans     &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
                                     &trans     &trans    &trans
                             &trans  &trans     &trans    &trans  &trans  &trans
                             &trans  &kp SPACE  &trans    &trans  &trans  &trans
            >;
        };

        macrosLayer {
            bindings = <
&trans  &trans  &trans          &trans             &trans     &trans    &trans  &trans  &trans  &trans          &trans  &trans
&trans  &trans  &wordSelection  &kp LG(LC(SPACE))  &trans     &trans    &trans  &trans  &trans  &trans          &trans  &trans
&trans  &trans  &trans          &discord           &copyFile  &trans    &trans  &trans  &trans  &laughingEmoji  &trans  &trans
&trans  &trans  &kp LA(LG(X))   &commaSpace        &trans     &trans    &trans  &trans  &trans  &trans          &trans  &trans
&trans  &trans  &trans          &trans             &trans                       &trans  &trans  &trans          &trans  &trans
                                                   &trans     &trans    &trans
                                &trans             &trans     &trans    &trans  &trans  &trans
                                &trans             &trans     &trans    &trans  &trans  &trans
            >;
        };

        symbolsLayer {
            bindings = <
&trans        &trans     &trans         &trans                  &trans     &trans           &trans                          &trans                           &trans                 &trans      &trans                &trans
&trans        &kp GRAVE  &kp LESS_THAN  &kp GREATER_THAN        &kp MINUS  &kp PIPE         &kp CARET                       &curlyBracketBehavior            &kp RIGHT_BRACE        &kp DOLLAR  &unicodeArrowsSymbol  &trans
&kp QUESTION  &kp EXCL   &kp ASTRK      &kp FSLH                &kp EQUAL  &kp AMPERSAND    &commentingProgrammingBehavior  &programmingParenthesisBehavior  &kp RIGHT_PARENTHESIS  &kp UNDER   &kp SEMICOLON         &doubleQuoteBehavior
&trans        &kp TILDE  &kp PLUS       &squareBracketBehavior  &kp RBKT   &kp PERCENT      &kp AT                          &kp COLON                        &kp COMMA              &kp DOT     &singleQuoteBehavior  &trans
&trans        &trans     &trans         &trans                  &trans                                                      &trans                           &trans                 &trans      &trans                &trans
                                                                &trans     &trans           &trans
                                        &trans                  &trans     &trans           &trans                          &trans                           &trans
                                        &trans                  &trans     &trans           &trans                          &trans                           &trans
            >;
        };

        longNumpad {
            bindings = <
&trans  &trans            &trans            &trans            &trans            &trans        &trans            &trans        &trans      &trans      &trans      &trans
&trans  &trans            &kp MINUS         &kp PLUS          &kp EQUAL         &trans        &trans            &kp ASTERISK  &kp SLASH   &trans      &trans      &trans
&trans  &kp N1            &kp N2            &kp N3            &kp N4            &kp N5        &kp N6            &kp N7        &kp N8      &kp N9      &kp N0      &trans
&trans  &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(N5)    &kp LS(NUMBER_6)  &kp LS(N7)    &kp LS(N8)  &kp LS(N9)  &kp LS(N0)  &trans
&trans  &trans            &trans            &trans            &trans                                            &trans        &trans      &trans      &trans      &trans
                                                              &trans            &trans        &trans
                                            &trans            &trans            &trans        &trans            &trans        &trans
                                            &trans            &trans            &trans        &trans            &trans        &trans
            >;
        };

        arrows {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &trans        &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &trans        &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &kp UP_ARROW  &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp LEFT_ARROW  &kp DOWN      &kp RIGHT  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                            &trans        &trans     &trans  &trans  &trans
                                &trans  &trans    &trans
                        &trans  &trans  &trans    &trans          &trans        &trans
                        &trans  &trans  &trans    &trans          &trans        &trans
            >;
        };
    };
};
