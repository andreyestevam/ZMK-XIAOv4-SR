//#include <behaviors/mouse_keys.dtsi>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 140

#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        mouse_scroll: sensor_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC           &kp N1        &kp N2  &kp N3             &kp N4            &kp N5          &kp N6      &kp N7     &kp N8         &kp N9   &kp N0    &kp EQUAL
&kp TAB           &mt C_QUIT Q  &kp W   &mt C_AC_SEARCH E  &kp R             &kp T           &kp Y       &kp U      &kp I          &kp O    &kp P     &kp MINUS
&kp CAPSLOCK      &kp A         &kp S   &kp D              &kp F             &kp G           &kp H       &kp J      &kp K          &kp L    &kp SEMI  &kp SQT
&kp LSHFT         &kp Z         &kp X   &mt K_COPY C       &mt K_PASTE V     &kp B           &kp N       &kp M      &kp COMMA      &kp DOT  &kp FSLH  &kp BSLH
&kp LEFT_CONTROL  &mo 4         &mo 5   &mkp MB1           &mkp MB2                                      &kp F6     &kp F7         &kp F8   &kp F9    &kp F10
                                                           &kp C_PAUSE       &kp C_NEXT      &kp C_MUTE
                                        &kp LSHFT          &kp LEFT_CONTROL  &kp LEFT_ALT    &kp TAB     &kp DEL    &kp RGUI
                                        &kp SPACE          &kp LEFT_COMMAND  &kp TAB         &kp RSHIFT  &kp ENTER  &kp BACKSPACE
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>,
                <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        layer_1 {
            bindings = <
&bt BT_CLR  &bt BT_NXT  &trans  &trans  &trans  &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans      &trans  &trans  &trans  &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans      &trans  &trans  &trans  &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans      &trans  &trans  &trans  &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans      &trans  &trans  &trans                         &trans  &trans  &trans  &trans  &trans
                                        &trans  &bootloader    &trans
                                &trans  &trans  &trans         &trans  &trans  &trans
                                &trans  &trans  &trans         &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                         &trans  &trans  &trans  &trans  &trans
                                &trans  &trans    &bootloader
                        &trans  &trans  &trans    &trans       &trans  &trans
                        &trans  &trans  &trans    &trans       &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
                                &trans  &trans    &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        numPad {
            bindings = <
&trans  &trans  &trans  &trans    &trans    &trans    &kp ESCAPE   &kp N0        &kp SLASH     &kp ASTERISK  &kp MINUS    &kp CLEAR
&trans  &trans  &trans  &trans    &trans    &trans    &kp PERCENT  &kp N7        &kp N8        &kp N9        &kp KP_PLUS  &trans
&trans  &trans  &trans  &trans    &trans    &trans    &kp COMMA    &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp COMMA    &trans
&trans  &trans  &trans  &trans    &trans    &trans    &kp N0       &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp RETURN   &trans
&trans  &trans  &trans  &mkp MB1  &mkp MB2                         &kp N0        &kp PERIOD    &kp EQUAL     &kp ENTER    &trans
                                  &trans    &trans    &trans
                        &trans    &trans    &trans    &trans       &trans        &trans
                        &trans    &trans    &trans    &trans       &trans        &trans
            >;
        };

        mouseEmulation {
            bindings = <
&trans  &trans  &trans  &trans    &trans    &trans    &trans  &trans          &trans          &trans           &trans  &trans
&trans  &trans  &trans  &trans    &trans    &trans    &trans  &trans          &msc SCRL_UP    &trans           &trans  &trans
&trans  &trans  &trans  &trans    &trans    &trans    &trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans    &trans    &trans    &trans  &trans          &kp UP_ARROW    &trans           &trans  &trans
&trans  &trans  &trans  &mkp MB1  &mkp MB2                    &kp LEFT_ARROW  &kp DOWN        &kp RIGHT        &trans  &trans
                                  &trans    &trans    &trans
                        &trans    &trans    &trans    &trans  &trans          &trans
                        &trans    &trans    &trans    &trans  &trans          &trans
            >;
        };
    };
};
